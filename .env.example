# Docker Compose 与 Kubernetes 部署的本地模板。复制为 .env 后填写真实值，禁止提交 .env。
MYSQL_DATABASE=clas
MYSQL_USER=clas
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
REDIS_PASSWORD=
JWT_SECRET=replace-with-at-least-32-random-bytes
RIDER_IDENTITY_ENCRYPTION_KEY=replace-with-a-32-byte-aes-key
AMAP_WEB_SERVICE_KEY=
DASHSCOPE_API_KEY=
FORBIDDEN_WORDS=
CHAT_MODERATION_TIMEOUT_MS=3000
CLAS_DEMO_ACCOUNTS_ENABLED=false
CLAS_DEMO_ACCESS_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://8.141.112.182
