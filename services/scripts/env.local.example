# 复制为 env.local 后按本机修改（env.local 已被 .gitignore 忽略）
# 用法：start-services.ps1 会自动加载

# MySQL（与 database/schema.sql 同一库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=clas
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# #36 P3 各服务写隔离（运行 isolate-service-privileges.ps1 后启用）
# MYSQL_ADMIN_USER=root
# MYSQL_USER=clas_app
# MYSQL_IAM_USER=clas_iam_app
# MYSQL_MERCHANT_USER=clas_merchant_app
# MYSQL_CATALOG_USER=clas_catalog_app
# MYSQL_ORDER_USER=clas_order_app
# MYSQL_COMPAT_USER=clas_compat_app
# MYSQL_IAM_PASSWORD=your_service_app_password
# MYSQL_MERCHANT_PASSWORD=your_service_app_password
# MYSQL_CATALOG_PASSWORD=your_service_app_password
# MYSQL_ORDER_PASSWORD=your_service_app_password
# MYSQL_COMPAT_PASSWORD=your_service_app_password
# MYSQL_APP_PASSWORD=your_app_password

# Redis（验证码；无 Redis 时可装 Memurai 或 Docker redis）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (must be identical across four services; do not use forbidden defaults)
JWT_SECRET=clas-local-integration-secret-2026-hint314!

# 服务间内部接口密钥（四个服务必须相同；请替换为自己的随机值）
CLAS_INTERNAL_API_KEY=replace-with-a-long-random-service-key

# 本地联调：固定验证码，登录/注册可填 123456
CLAS_VERIFICATION_FIXEDCODE=123456

# 演示快捷登录（可选）
CLAS_DEMO_ACCOUNTS_ENABLED=true
CLAS_DEMO_ACCESS_PASSWORD=demo314

# 服务端口（默认即可）
CLAS_IAM_PORT=8081
CLAS_MERCHANT_PORT=8085
CLAS_CATALOG_PORT=8082
CLAS_ORDER_PORT=8083
CLAS_COMPAT_PORT=8084
CLAS_IAM_HOST=localhost
CLAS_MERCHANT_HOST=localhost
CLAS_CATALOG_HOST=localhost
CLAS_ORDER_HOST=localhost
CLAS_COMPAT_HOST=localhost

# 网关
CLAS_GATEWAY_PORT=8080
