# 复制为 env.local 后按本机修改（env.local 已被 .gitignore 忽略）
# 用法：start-services.ps1 会自动加载

# MySQL（与 database/schema.sql 同一库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=clas
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Redis（验证码；无 Redis 时可装 Memurai 或 Docker redis）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (must be identical across four services; do not use forbidden defaults)
JWT_SECRET=clas-local-integration-secret-2026-hint314!

# 本地联调：固定验证码，登录/注册可填 123456
CLAS_VERIFICATION_FIXEDCODE=123456

# 演示快捷登录（可选）
CLAS_DEMO_ACCOUNTS_ENABLED=true
CLAS_DEMO_ACCESS_PASSWORD=demo314

# 服务端口（默认即可）
CLAS_IAM_PORT=8081
CLAS_CATALOG_PORT=8082
CLAS_ORDER_PORT=8083
CLAS_COMPAT_PORT=8084

# 网关
CLAS_GATEWAY_PORT=8080
