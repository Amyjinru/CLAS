' ------------------------------------------------------------
' 1. 概念类图（UC05–UC08 共享领域模型）
' ------------------------------------------------------------
@startuml
hide empty methods
hide empty attributes
skinparam classAttributeIconSize 0

class 用户
class 商家
class 收藏
class 通知
class 审核日志
class 商品分类
class 商品
class 普通优惠券
class 用户券
class 订单
class 团购套餐
class 团购券
class 核销日志

用户 "1" --> "0..1" 商家 : 入驻拥有
用户 "1" --> "*" 收藏 : 创建
商家 "1" --> "*" 收藏 : 被收藏
用户 "1" --> "*" 通知 : 接收
商家 "1" --> "*" 审核日志 : 被审核
用户 "1" --> "*" 审核日志 : 操作
商家 "1" --> "*" 商品分类 : 定义
商家 "1" --> "*" 商品 : 在售
商品分类 "1" --> "*" 商品 : 分组
普通优惠券 "1" --> "*" 用户券 : 被领取
用户 "1" --> "*" 用户券 : 拥有
用户券 "0..1" --> "0..1" 订单 : 预占
商家 "1" --> "*" 团购套餐 : 提供
团购套餐 "1" --> "*" 团购券 : 购买产生
用户 "1" --> "*" 团购券 : 拥有
团购券 "1" --> "0..1" 核销日志 : 核销
@enduml

' ------------------------------------------------------------
' 2. UC05 系统级顺序图（用户收藏 + 通知，系统为黑盒）
' ------------------------------------------------------------
@startuml
actor 用户 as U
participant "CLAS 系统" as S
participant "业务服务\n(订单/团购/预约/评价)" as B

U -> S : 点击收藏商家 (POST /api/favorites/{merchantId})
activate S
S --> U : 返回收藏结果（重复时复用已有关系）
deactivate S

B -> S : 业务状态变化 → 写入结构化通知
activate S
S --> B : 通知已保存
deactivate S

U -> S : 打开通知中心 (GET /api/notifications/mine)
activate S
S --> U : 本人通知（未读优先、时间倒序）
deactivate S

U -> S : 点击通知 (POST /api/notifications/{id}/read)
activate S
S --> U : 已读
deactivate S

U -> U : 白名单解析受控站内目标并跳转\n(追加 from=notifications)

U -> S : 取消收藏 / 全部已读 / 删除 / 清空
activate S
S --> U : 操作完成（仅限本人数据）
deactivate S
@enduml

' ------------------------------------------------------------
' 3. UC06 系统级状态图（商家审核五态机）
' ------------------------------------------------------------
@startuml
[*] --> PENDING : 入驻申请成功
PENDING --> PENDING : 补充管理员备注
PENDING --> APPROVED : 管理员批准
PENDING --> BLOCKED : 管理员禁用
APPROVED --> APPROVED : 补充管理员备注
APPROVED --> OPEN : 开通营业
APPROVED --> CLOSED : 暂不营业
APPROVED --> BLOCKED : 禁用
OPEN --> OPEN : 补充管理员备注
OPEN --> CLOSED : 停业
OPEN --> BLOCKED : 禁用
CLOSED --> CLOSED : 补充管理员备注
CLOSED --> OPEN : 恢复营业
CLOSED --> BLOCKED : 禁用
BLOCKED --> BLOCKED : 补充管理员备注
BLOCKED --> APPROVED : 恢复待开通
BLOCKED --> CLOSED : 恢复但停业
BLOCKED --> OPEN : 直接恢复营业
@enduml

' ------------------------------------------------------------
' 4. UC07 系统级活动图（商家维护商品流程）
' ------------------------------------------------------------
@startuml
|商家|
start
:进入商家工作台;
:查看/编辑店铺资料、商品分类、商品;
|系统|
:从认证上下文解析当前商家 ID;
:校验敏感字段验证码、地图坐标、配送范围、营业时间;
:保存资料 / 创建、编辑、上下架、软删除商品;
:刷新店铺人均价格;
|用户|
:访问商家详情页;
:仅查看 ON_SALE 商品及有商品的分类分组;
stop
@enduml

' ------------------------------------------------------------
' 5. UC08 系统级状态图（普通券 + 团购券生命周期）
' ------------------------------------------------------------
@startuml
state "普通优惠券 (user_coupon)" as Coupon {
  [*] --> UNUSED : 领取
  UNUSED --> RESERVED : 创建订单并绑定 order_id
  RESERVED --> UNUSED : 订单取消/超时
  RESERVED --> USED : 支付成功且 order_id 匹配
  UNUSED --> EXPIRED : 有效期结束
}

state "团购券 (deal_order)" as Deal {
  [*] --> PENDING_PAYMENT : 发起购买
  PENDING_PAYMENT --> UNUSED : 支付成功 / 扣库存 / 生成券码
  UNUSED --> USED : 所属商家核销
  UNUSED --> EXPIRED : 超过有效期
  UNUSED --> REFUNDED : 用户退款 / 恢复库存
}
@enduml
