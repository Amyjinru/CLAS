' ------------------------------------------------------------
' 1. 组件图（UC05–UC08 共享，对应 MOD-* 模块划分）
' ------------------------------------------------------------
@startuml
package "客户端 Vue 3" {
  [页面/组件] as UI
  [Vue Router 角色守卫] as RT
  [Axios API 客户端] as AX
}

package "后端 Spring Boot" {
  [认证/请求追踪拦截器] as AUTH
  [Favorite Controller/Service] as MOD_FAV
  [Notification Controller/Service] as MOD_NOTIFY
  [Merchant Controller/Service] as MOD_MER
  [Audit 审核状态机/日志] as MOD_AUDIT
  [Product Controller/Service] as MOD_PROD
  [Coupon Controller/Service] as MOD_COUPON
  [Order/Payment Controller/Service] as MOD_ORDER
  [Deal Controller/Service] as MOD_DEAL
  [MyBatis Plus Mapper 层] as MAPPER
}

database "MySQL" as DB
database "Redis 验证码" as REDIS
node "模拟支付" as PAY

UI --> RT
RT --> AX
AX --> AUTH : JWT + JSON
AUTH --> MOD_FAV
AUTH --> MOD_NOTIFY
AUTH --> MOD_MER
AUTH --> MOD_PROD
AUTH --> MOD_COUPON
AUTH --> MOD_ORDER
AUTH --> MOD_DEAL
MOD_MER --> MOD_AUDIT
MOD_FAV --> MAPPER
MOD_NOTIFY --> MAPPER
MOD_MER --> MAPPER
MOD_AUDIT --> MAPPER
MOD_PROD --> MAPPER
MOD_COUPON --> MAPPER
MOD_ORDER --> MAPPER
MOD_DEAL --> MAPPER
MAPPER --> DB
MOD_MER --> REDIS : 验证码
MOD_ORDER --> PAY : 模拟支付
MOD_DEAL --> PAY : 模拟支付
@enduml

' ------------------------------------------------------------
' 2. UC05 组件级顺序图
' ------------------------------------------------------------
@startuml
actor 用户 as U
participant "UI\nMerchantDetail/Profile/Notifications" as UI
participant "FavoriteController" as FC
participant "FavoriteService" as FS
participant "FavoriteMapper" as FM
participant "NotificationController" as NC
participant "NotificationService" as NS
participant "业务服务\n(订单/团购/预约/评价)" as BS
database "MySQL" as DB

U -> UI : 点击收藏商家
UI -> FC : POST /api/favorites/{merchantId}
FC -> FS : add(merchantId)
FS -> FM : 查询商家 + 查询/写入收藏
FM -> DB : SELECT/INSERT favorite
DB --> FS : 收藏关系
FS --> UI : 返回收藏结果（重复时复用）

BS -> NS : send(NotificationTarget)
NS -> DB : INSERT notification(read_flag=false)

U -> UI : 打开通知中心
UI -> NC : GET /api/notifications/mine
NC -> NS : mine()
NS -> DB : 本人通知，未读优先/倒序
DB --> UI : 通知列表

U -> UI : 点击通知
UI -> NC : POST /api/notifications/{id}/read
NC -> NS : markRead(id)
NS -> DB : UPDATE read_flag=true
UI -> UI : 白名单解析并跳转
@enduml

' ------------------------------------------------------------
' 3. UC06 组件级顺序图
' ------------------------------------------------------------
@startuml
actor 申请人 as A
actor 管理员 as M
participant "UI\nRegister/AuditStatus/AdminAudit" as UI
participant "MerchantController" as MC
participant "MerchantService" as MS
participant "验证码存储(Redis)" as VC
database "MySQL\nuser/merchant/merchant_audit_log" as DB

A -> UI : 填写账号+店铺+地图资料
UI -> MC : POST /api/merchant/register
MC -> MS : register(request, currentUserId)
MS -> VC : 游客验证码校验
VC --> MS : 校验结果
MS -> DB : 创建/升级账号 + INSERT merchant(PENDING)
DB --> MS : merchant
MS --> A : PENDING 商家

A -> MC : GET /api/merchant/my/audit-status
MC --> A : status/adminRemarks/auditTimeline

M -> MC : POST /api/merchant/admin/audit/{id}
MC -> MS : audit(id, request, adminId)
MS -> MS : validateStatusTransition(old, new)
MS -> DB : UPDATE merchant + INSERT merchant_audit_log
DB --> MS : 更新结果
MS --> M : 更新后的商家
@enduml

' ------------------------------------------------------------
' 4. UC07 组件级顺序图
' ------------------------------------------------------------
@startuml
actor 商家 as M
participant "UI\n工作台/资料/商品" as UI
participant "MerchantController" as MC
participant "MerchantService" as MS
participant "ProductController" as PC
participant "ProductService" as PS
participant "验证码存储(Redis)" as VC
database "MySQL\nmerchant/product_category/product" as DB

M -> UI : 进入工作台/编辑资料
UI -> MC : PUT /api/merchant/my/profile
MC -> MS : updateMyProfile(request)
MS -> MS : getCurrentMerchantId() 解析商家 ID
MS -> VC : 敏感字段验证码校验
VC --> MS : 校验结果
MS -> DB : UPDATE merchant

UI -> MC : POST /api/merchant/my/manual-closed/toggle
MC -> MS : toggleManualClosed()
MS -> DB : UPDATE merchant(manual_closed)

UI -> PC : POST/PUT/DELETE /api/merchant/me/products/**
PC -> PS : createProduct/updateStatus/deleteProduct
PS -> DB : INSERT/UPDATE product (ON_SALE/OFF_SALE/DELETED)
PS -> PS : 刷新店铺人均价格

UI -> PC : POST/PUT/DELETE /api/product/categories
PC -> PS : createCategory/updateCategory/deleteCategory
PS -> DB : 分类 CRUD（删除分类保留商品并转未分类）
@enduml

' ------------------------------------------------------------
' 5. UC08 组件级顺序图
' ------------------------------------------------------------
@startuml
actor 用户 as U
actor 商家 as M
participant "UI\nCart/DealDetail/Payment/DealOrderDetail" as UI
participant "CouponController" as CC
participant "CouponService" as CS
participant "OrderController" as OC
participant "OrderService" as OS
participant "PaymentService" as PayS
participant "DealController" as DC
participant "DealService" as DS
participant "NotificationService" as NS
database "MySQL\ncoupon/user_coupon/orders/group_deal/deal_order/redeem_log" as DB
participant "模拟支付" as PAY

U -> UI : 领取普通券
UI -> CC : POST /api/coupon/claim/{couponId}
CC -> CS : claim(userId, couponId)
CS -> DB : 条件更新 claimed_count + INSERT user_coupon(UNUSED)

U -> UI : 下单
UI -> OC : POST /api/order/create
OC -> OS : create(...)
OS -> DB : INSERT orders + 用户券 UNUSED->RESERVED 绑定 order_id

U -> UI : 支付
UI -> OC : POST /api/payment/mock
OC -> PayS : mockPay(...)
PayS -> PAY : 模拟支付
PayS -> DB : 扣库存 + 订单已支付 + 券 RESERVED->USED

U -> UI : 购买团购
UI -> DC : POST /api/deals/{dealId}/buy
DC -> DS : buy(dealId)
DS -> DB : INSERT deal_order(PENDING_PAYMENT)
DS -> NS : 待支付通知

U -> DC : POST /api/deals/orders/{id}/pay
DC -> DS : payDealOrder(id, userId, method)
DS -> PAY : 模拟支付
DS -> DB : 条件扣库存 + UNUSED + 正式券码/有效期
DS -> NS : 购买成功通知

M -> DC : POST /api/deals/redeem {voucherCode}
DC -> DS : redeem(voucherCode)
DS -> DB : 校验本店/未使用/未过期 → USED + INSERT deal_redeem_log
DS -> NS : 核销通知
@enduml
