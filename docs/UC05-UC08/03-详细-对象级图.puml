' ------------------------------------------------------------
' 1. UC05 类图（收藏与通知）
' ------------------------------------------------------------
@startuml
class FavoriteController {
  + mine()
  + add(merchantId)
  + remove(merchantId)
}
class FavoriteService {
  + add(merchantId)
  + remove(merchantId)
  + mine()
}
class Favorite {
  - id
  - userId
  - merchantId
  - createdAt
}
class FavoriteMapper

class NotificationController {
  + mine()
  + markRead(id)
  + markAllRead()
  + deleteOne(id)
  + deleteAllMine()
}
class NotificationService {
  + send(target)
  + mine()
  + markRead(id)
  + markAllRead()
  + deleteOne(id)
  + deleteAllMine()
  + backfillLegacyTarget()
}
class Notification {
  - id
  - userId
  - title
  - content
  - readFlag
  - type
  - targetType
  - targetId
  - reviewId
  - replyId
  - orderId
  - merchantId
  - targetPath
  - createdAt
}
class NotificationMapper
class LegacyNotificationTargetResolver {
  + resolve(notification)
}

FavoriteController --> FavoriteService
NotificationController --> NotificationService
FavoriteService --> FavoriteMapper
NotificationService --> NotificationMapper
NotificationService --> LegacyNotificationTargetResolver
@enduml

' ------------------------------------------------------------
' 2. UC06 类图（入驻与审核）
' ------------------------------------------------------------
@startuml
enum MerchantStatusEnum {
  PENDING
  APPROVED
  OPEN
  CLOSED
  BLOCKED
}

class MerchantController {
  + register(request)
  + sendRegisterCode(phone)
  + getMyMerchant()
  + getMyAuditStatus()
  + listAll()
  + audit(id, request)
  + getAuditLogs(id)
}
class MerchantService {
  + register(request, currentUserId)
  + audit(id, request, adminId)
  + validateStatusTransition(old, new)
  + getAuditLogs(merchantId)
  + getCurrentMerchantId()
}
class Merchant {
  - id
  - userId
  - merchantName
  - phone
  - category
  - address
  - longitude
  - latitude
  - status
  - manualClosed
  - adminRemarks
  - bankAccount
  - settlementCycle
}
class MerchantAuditLog {
  - id
  - merchantId
  - adminId
  - oldStatus
  - newStatus
  - remarks
  - createdAt
}
class MerchantRegisterRequest {
  - accountPhone
  - username
  - password
  - merchantName
  - phone
  - category
  - address
  - longitude
  - latitude
}
class MerchantAuditRequest {
  - status
  - remarks
}
class MerchantResponse

MerchantController --> MerchantService
MerchantService --> Merchant
MerchantService --> MerchantAuditLog
MerchantService ..> MerchantStatusEnum
MerchantController ..> MerchantRegisterRequest
MerchantController ..> MerchantAuditRequest
MerchantController ..> MerchantResponse
@enduml

