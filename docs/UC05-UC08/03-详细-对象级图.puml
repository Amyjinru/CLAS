' ------------------------------------------------------------
' 5. UC05 对象级顺序图（Favorite / Notification 对象）
' ------------------------------------------------------------
@startuml
participant ":FavoriteService" as FS
participant "f:Favorite" as F
participant ":NotificationService" as NS
participant "n:Notification" as N

FS -> F : add(userId, merchantId)
activate F
F -> F : 已存在? 复用 : 新建
F --> FS : 收藏关系
deactivate F

NS -> N : send(NotificationTarget)
activate N
N -> N : 写入 readFlag=false
N --> NS : 通知已创建
deactivate N

NS -> N : markRead(id)
activate N
N -> N : readFlag: false → true
N --> NS : 已读
deactivate N
@enduml

' ------------------------------------------------------------
' 6. UC06 对象级顺序图（Merchant / MerchantAuditLog 对象）
' ------------------------------------------------------------
@startuml
participant ":MerchantService" as MS
participant "m:Merchant" as M
participant "log:MerchantAuditLog" as L
database ":MySQL" as DB

MS -> M : audit(oldStatus=PENDING, newStatus=APPROVED)
activate M
M -> M : validateStatusTransition
M -> DB : UPDATE status=APPROVED, adminRemarks
M --> MS : 更新后的 merchant
deactivate M

MS -> L : 创建审核日志
activate L
L -> DB : INSERT (merchantId, adminId, old, new, remarks, time)
L --> MS : 日志已保存
deactivate L
@enduml

' ------------------------------------------------------------
' 7. UC07 对象级状态图（商品状态机）
' ------------------------------------------------------------
@startuml
[*] --> ON_SALE : 创建商品
ON_SALE --> OFF_SALE : 下架
OFF_SALE --> ON_SALE : 上架
ON_SALE --> DELETED : 软删除
OFF_SALE --> DELETED : 软删除
@enduml

' ------------------------------------------------------------
' 8. UC08 对象级顺序图（GroupDeal / DealOrder / DealRedeemLog 对象）
' ------------------------------------------------------------
@startuml
participant ":DealService" as DS
participant "g:GroupDeal" as G
participant "d:DealOrder" as D
participant "log:DealRedeemLog" as L

DS -> G : payDealOrder → deductStock()
activate G
G -> G : 条件扣减库存
G --> DS : 扣减成功
deactivate G

DS -> D : 生成正式券码 + 设置有效期
activate D
D -> D : PENDING_PAYMENT → UNUSED
D --> DS : 可用券
deactivate D

DS -> D : redeem(voucherCode)
activate D
D -> D : 校验本店/未使用/未过期 → USED + usedTime
D --> DS : 核销成功
deactivate D

DS -> L : 创建核销日志
activate L
L --> DS : 日志已保存
deactivate L
@enduml
